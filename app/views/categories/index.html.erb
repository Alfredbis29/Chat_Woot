<div class="hc-page">
  <header class="hc-header">
    <div class="hc-header__content">
      <nav>
        <%= link_to "← Back to Help Center", root_path, class: "hc-back-link" %>
      </nav>
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div>
          <h1 class="hc-title">Browse by Category</h1>
          <p class="hc-subtitle">Explore categories and organize your support content.</p>
        </div>
        <div>
          <%= link_to "Create Category", new_category_path, class: "hc-btn hc-btn--primary" %>
        </div>
      </div>
      
      <%= form_with url: search_path, method: :get, local: true, class: "hc-search" do |form| %>
        <%= form.search_field :q, id: "search-input", placeholder: "Quick search..." %>
        <%= form.submit "Search" %>
      <% end %>
    </div>
  </header>

  <main class="hc-main">
    <% if @categories.any? %>
      <div class="hc-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
        <% @categories.each do |category| %>
          <section class="hc-card" style="animation: fadeIn 0.4s ease-in-out;">
            <h2><%= category.name %></h2>
            <p style="color: #64748b; margin-bottom: 1rem;"><%= category.description.presence || "No description available yet." %></p>
            <p style="margin: 0.5rem 0; font-weight: 600; color: #0f172a;">Articles: <%= category.articles_count %></p>
            <p style="margin: 0.5rem 0; color: #475569;">Slug: <%= category.slug %></p>
          </section>
        <% end %>
      </div>

      <style>
        @keyframes fadeIn {
          from {
            opacity: 0;
            transform: translateY(10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      </style>
    <% else %>
      <div class="hc-empty-state">
        <div class="hc-empty-state__icon">📁</div>
        <h2 class="hc-empty-state__title">No Categories Found</h2>
        <p class="hc-empty-state__description">
          There are no categories available yet. Create one to start organizing your help center.
        </p>
        <p style="margin-top: 1.5rem;">
          <%= link_to "Create Category", new_category_path, class: "hc-btn hc-btn--primary" %>
        </p>
      </div>
    <% end %>
  </main>
</div>
