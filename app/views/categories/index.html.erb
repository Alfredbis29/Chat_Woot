<div class="hc-page">
  <header class="hc-header">
    <div class="hc-header__content">
      <nav>
        <%= link_to "← Back to Help Center", root_path, class: "hc-back-link" %>
      </nav>
      <h1 class="hc-title">Browse by Category</h1>
      <p class="hc-subtitle">Explore articles organized by topic</p>
      
      <%= form_with url: search_path, method: :get, local: true, class: "hc-search" do |form| %>
        <%= form.search_field :q, id: "search-input", placeholder: "Quick search..." %>
        <%= form.submit "Search" %>
      <% end %>
    </div>
  </header>

  <main class="hc-main">
    <% if @categories.any? %>
      <% @categories.each_with_index do |(category_name, articles), index| %>
        <section class="hc-section" style="animation: fadeIn 0.5s ease-in-out; animation-delay: <%= index * 0.1 %>s;">
          <h2 style="margin-top: 0; margin-bottom: 1.5rem; color: #1e293b; font-size: 1.5rem; display: flex; align-items: center; gap: 0.75rem;">
            <span style="display: inline-flex; width: 32px; height: 32px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 0.5rem; align-items: center; justify-content: center; color: white; font-size: 1rem;">
              <%= ['📚', '🔧', '🔗', '❓', '🛡️', '⚙️', '📊', '🚀'][index % 8] %>
            </span>
            <%= category_name %>
          </h2>
          <p style="color: #64748b; font-size: 0.95rem; margin: 0 0 1.5rem;">
            Explore <strong><%= articles.count %></strong> article<%= articles.count == 1 ? '' : 's' %> about <%= category_name.downcase %>
          </p>
          <div class="hc-grid">
            <% articles.each do |article| %>
              <article class="hc-card" role="link" tabindex="0" @click="goToArticle('<%= article_path(article[:slug]) %>')" style="cursor: pointer;">
                <h3><%= article[:title] %></h3>
                <p><%= article[:description] || "Learn more about #{article[:title].downcase} in ChatWoot." %></p>
                <%= link_to "Read article →", article_path(article[:slug]) %>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
      
      <style>
        @keyframes fadeIn {
          from {
            opacity: 0;
            transform: translateY(10px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      </style>
    <% else %>
      <div class="hc-empty-state">
        <div class="hc-empty-state__icon">📁</div>
        <h2 class="hc-empty-state__title">No Categories Found</h2>
        <p class="hc-empty-state__description">
          There are no categories available at the moment.
        </p>
        <p style="margin-top: 1.5rem;">
          <%= link_to "← Back to Help Center", root_path, class: "hc-btn hc-btn--primary" %>
        </p>
      </div>
    <% end %>
  </main>
</div>
