<!DOCTYPE html>
<html>
  <head>
    <title>ChatWoot - Help Center</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="ChatWoot Help Center - Your comprehensive guide to using ChatWoot effectively">
    <meta name="theme-color" content="#667eea">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  </head>

  <body>
    <nav class="hc-navbar">
      <div class="hc-navbar__content">
        <div class="hc-navbar__logo">
          <%= link_to "ChatWoot", root_path, class: "hc-logo" %>
        </div>
        <ul class="hc-navbar__menu">
          <li><%= link_to "Home", root_path %></li>
          <li><%= link_to "Categories", categories_path %></li>
          <li><%= link_to "Search", search_path %></li>
          <li><%= link_to "Contact", contact_path, class: "hc-btn hc-btn--primary" %></li>
        </ul>
        <button class="hc-navbar__toggle" id="mobile-menu-toggle" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>

    <main class="hc-content">
      <%= yield %>
    </main>

    <script>
      document.getElementById('mobile-menu-toggle')?.addEventListener('click', function() {
        document.querySelector('.hc-navbar__menu').classList.toggle('hc-navbar__menu--active');
      });
    </script>
  </body>
</html>
